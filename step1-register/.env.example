# Postgres (Supabase: Project settings > Database > Connection string, session pooler, URI)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/projectinv
PORT=4100
ORGANIZATION_NAME=Default organization
# Optional shared password for the API/UI
APP_PASSWORD=
# Procore (omit the client id/secret, or set PROCORE_MODE=demo, to run on the built-in Bangkok Central demo company)
PROCORE_MODE=
PROCORE_BASE_URL=https://sandbox.procore.com
PROCORE_COMPANY_ID=4283715
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
# WBS segment ids; looked up by name ("Cost Code", "Cost Type") when unset
PROCORE_COST_CODE_SEGMENT_ID=
PROCORE_COST_TYPE_SEGMENT_ID=
SYNC_ON_START=false
# Automatic BOQ capture from Procore Documents
# Shared secret Procore sends as "Authorization: Bearer <secret>" on webhook deliveries (webhooks are refused when unset)
PROCORE_WEBHOOK_SECRET=
# Minutes between catch-up scans of each project's watched folder (default 15 with live Procore, off in demo; 0 = off)
PROCORE_SCAN_MINUTES=
